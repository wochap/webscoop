{
  "name": "webscoop-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/playground",
    "packages/browser",
    "packages/llm",
    "packages/inject",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "lint": "eslint .",
    "playground": "tsx packages/playground/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "playwright": "1.59.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
