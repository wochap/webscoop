  "steps": [
    {
      "kind": "click",
      "target": {
        "selectors": [
          {
            "strategy": "role",
            "value": "button|Accept all",
            "stability": "stable"
          },
          {
            "strategy": "id",
            "value": "consent-accept",
            "stability": "stable"
          },
          {
            "strategy": "css",
            "value": "button.consent-button",
            "stability": "medium"
          }
        ],
        "fingerprint": {
          "tag": "button",
          "role": "button",
          "name": "Accept all",
          "textSample": "Accept all",
          "attrs": {
            "id": "consent-accept",
            "type": "button"
          },
          "ancestors": [
            "dialog",
            "main",
            "body",
            "html"
          ],
          "bbox": {
            "x": 400,
            "y": 300,
            "w": 90,
            "h": 36
          }
        }
      },
      "when": "first-page",
      "optional": false,
      "label": "accept cookies"
    },
    {
      "kind": "wait",
      "target": {
        "selectors": [
          {
            "strategy": "testid",
            "value": "product-card",
            "stability": "stable"
          }
        ]
      },
      "when": "first-page",
      "optional": false
    },
    {
      "kind": "wait",
      "value": "100",
      "when": "first-page",
      "optional": true
    }
  ],
  "pagination": {
    "kind": "none",
    "limit": 1,
    "stopRules": [],
    "delayMs": 0
  },
  "guards": [
    {
      "kind": "login",
      "enabled": true
    },
    {
      "kind": "captcha",
      "enabled": true
    },
    {
      "kind": "zero-fields",
      "enabled": true
    }
  ],
  "healing": {
    "fuzzyThreshold": 0.7,
    "llm": true
  }
}
