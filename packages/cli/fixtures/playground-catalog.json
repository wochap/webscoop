{
  "schemaVersion": 1,
  "name": "playground-catalog",
  "url": "http://127.0.0.1:{port}/catalog?tier={tier}",
  "vars": [
    { "name": "port", "type": "string", "default": "4777" },
    { "name": "tier", "type": "string", "default": "0" }
  ],
  "item": {
    "selectors": [
      { "strategy": "testid", "value": "product-card", "stability": "stable" },
      { "strategy": "css", "value": "article.product-card", "stability": "medium" }
    ],
    "exclude": []
  },
  "fields": [
    {
      "name": "title",
      "type": "text",
      "scope": "item",
      "selectors": [
        { "strategy": "role", "value": "heading", "stability": "stable" },
        { "strategy": "css", "value": "h2.product-title", "stability": "medium" },
        { "strategy": "xpath", "value": ".//h2", "stability": "fragile" }
      ],
      "optional": false,
      "fingerprint": {
        "tag": "h2",
        "role": "heading",
        "name": "Wireless Mouse",
        "textSample": "Wireless Mouse",
        "attrs": { "class": "product-title" },
        "ancestors": ["article", "li", "list", "main", "body", "html"],
        "bbox": { "x": 32, "y": 118, "w": 280, "h": 28 }
      }
    },
    {
      "name": "price",
      "type": "number",
      "scope": "item",
      "selectors": [
        { "strategy": "testid", "value": "price", "stability": "stable" },
        { "strategy": "css", "value": ".product-price", "stability": "medium" }
      ],
      "optional": false
    },
    {
      "name": "url",
      "type": "url",
      "scope": "item",
      "selectors": [
        { "strategy": "css", "value": "a.product-link", "stability": "medium" },
        { "strategy": "role", "value": "link|View details", "stability": "stable" }
      ],
      "attr": "href",
      "optional": false,
      "key": true
    },
    {
      "name": "image",
      "type": "image",
      "scope": "item",
      "selectors": [
        { "strategy": "css", "value": "img.product-image", "stability": "medium" }
      ],
      "attr": "src",
      "optional": false
    },
    {
      "name": "rating",
      "type": "number",
      "scope": "item",
      "selectors": [
        { "strategy": "testid", "value": "rating", "stability": "stable" },
        { "strategy": "css", "value": ".product-rating", "stability": "medium" }
      ],
      "optional": false
    },
    {
      "name": "category",
      "type": "text",
      "scope": "page",
      "selectors": [
        { "strategy": "testid", "value": "category", "stability": "stable" },
        { "strategy": "css", "value": "h1.category-heading", "stability": "medium" }
      ],
      "optional": false
    }
  ],
  "pagination": {
    "kind": "none",
    "limit": 1,
    "stopRules": [],
    "delayMs": 0
  },
  "guards": [
    { "kind": "login", "enabled": true },
    { "kind": "captcha", "enabled": true },
    { "kind": "zero-fields", "enabled": true }
  ],
  "healing": {
    "fuzzyThreshold": 0.7,
    "llm": true
  }
}
