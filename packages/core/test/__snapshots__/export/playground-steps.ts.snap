const LEAD = 0;
const PAGINATION: Pagination = {
  "kind": "none",
  "table": null,
  "param": null,
  "paramInTemplate": false,
  "target": null,
  "limit": 1,
  "stopRules": [],
  "delayMs": 0
};
/** Functions evaluated in the page, from webscoop core. */
const PAGE_JS: Record<string, string> = {
  "classifyFill": "function classifyFillElement(el) {\n\tconst tag = el.tagName.toLowerCase();\n\tconst role = (el.getAttribute(\"role\") ?? \"\").toLowerCase();\n\tconst type = tag === \"input\" ? (el.type || \"text\").toLowerCase() : \"\";\n\tif (type === \"file\") return \"file\";\n\tif (type === \"checkbox\" || role === \"checkbox\" || role === \"switch\") return \"toggle\";\n\tif (type === \"radio\" || role === \"radio\") return \"radio\";\n\tif (tag === \"select\") return \"select\";\n\tconst autocomplete = (el.getAttribute(\"aria-autocomplete\") ?? \"\").toLowerCase();\n\tif (role === \"combobox\" || tag === \"input\" && (autocomplete !== \"\" && autocomplete !== \"none\" || el.hasAttribute(\"list\"))) return \"combobox\";\n\tconst nonText = [\n\t\t\"button\",\n\t\t\"submit\",\n\t\t\"reset\",\n\t\t\"image\",\n\t\t\"hidden\",\n\t\t\"range\",\n\t\t\"color\"\n\t];\n\tif (tag === \"input\" && nonText.includes(type)) return \"none\";\n\tif (tag === \"input\" && el.getAttribute(\"maxlength\") === \"1\") return \"otp\";\n\tconst editable = el.isContentEditable || [\n\t\t\"\",\n\t\t\"true\",\n\t\t\"plaintext-only\"\n\t].includes(el.getAttribute(\"contenteditable\") ?? \"false\");\n\tif (tag === \"input\" || tag === \"textarea\" || editable || role === \"textbox\") return \"text\";\n\treturn \"none\";\n}",
  "isChecked": "function isChecked(el) {\n\treturn el instanceof HTMLInputElement ? el.checked : el.getAttribute(\"aria-checked\") === \"true\";\n}",
  "selectValues": "function selectValues(el, wanted) {\n\tconst select = el;\n\tconst options = Array.from(select.options ?? []);\n\tconst want = select.multiple ? wanted.split(\"\\n\").filter((w) => w !== \"\") : [wanted];\n\tconst values = [];\n\tfor (const w of want) {\n\t\tconst hit = options.find((o) => o.value === w) ?? options.find((o) => o.label.trim() === w || o.text.trim() === w);\n\t\tif (!hit) return { missing: w };\n\t\tvalues.push(hit.value);\n\t};\n\treturn { values };\n}",
  "isEditable": "function isEditable(el) {\n\treturn el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el.isContentEditable;\n}",
  "readBack": "function readBack(el) {\n\treturn el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement ? el.value : el.textContent ?? \"\";\n}",
  "frameReachable": "function frameReachable(el) {\n\tif (!(el instanceof HTMLIFrameElement)) return false;\n\ttry {\n\t\treturn el.contentDocument !== null;\n\t} catch {\n\t\treturn false;\n\t}\n}",
  "isDisabled": "function isDisabled(el) {\n\treturn el.hasAttribute(\"disabled\") || el.getAttribute(\"aria-disabled\") === \"true\" || el.tagName.toLowerCase() === \"a\" && !el.hasAttribute(\"href\");\n}",
  "excludedMask": "function excludedMask(els, others) {\n\treturn els.map((el) => others.includes(el));\n}",
  "nextFrame": "function nextFrame() {\n\treturn new Promise((resolve) => requestAnimationFrame(() => resolve()));\n}",
  "scrollToBottom": "function scrollToBottom() {\n\twindow.scrollTo(0, document.documentElement.scrollHeight);\n}",
  "resolveUrl": "function resolveUrl([raw, base]) {\n\ttry {\n\t\treturn new URL(raw, base).href;\n\t} catch {\n\t\treturn raw;\n\t}\n}",
  "setQueryParam": "function setQueryParam([href, name, value]) {\n\tconst url = new URL(href);\n\turl.searchParams.set(name, value);\n\treturn url.href;\n}"
};

main(process.argv.slice(2)).then((code) => {
  process.exitCode = code;
});
